{
  "name": "rqark-agent-cloud-web-ui",
  "private": true,
  "version": "0.21.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "generate-assets": "mkdir -p public/apple-splash/v4/landscape public/apple-splash/v4/portrait && bunx pwa-assets-generator --config pwa-assets.config.js && node scripts/ios-splash-links.mjs",
    "format": "bunx prettier . --write",
    "lint": "bunx eslint .",
    "lint:fix": "bunx eslint . --fix",
    "dev": "vite --host",
    "build": "vue-tsc && vite build",
    "preview": "vite preview --host",
    "test": "vitest",
    "test:e2e": "bunx playwright test",
    "api-client": "bunx openapi-ts",
    "desktop:dev": "wails3 dev -config ./build/devmode.yml",
    "desktop:build": "wails3 task build",
    "desktop:build:windows": "wails3 task build GOOS=windows GOARCH=amd64",
    "desktop:icons": "node scripts/generate-desktop-icons.mjs && sh scripts/generate-windows-resource.sh"
  },
  "dependencies": {
    "@wailsio/runtime": "3.1.0",
    "dompurify": "^3.4.16",
    "marked": "^18.0.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.34",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.87.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.12.3",
    "@typescript-eslint/parser": "^8.50.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "daisyui": "^5.5.23",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.9.0",
    "jsdom": "^26.1.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.50.0",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.2.8"
  }
}
