FROM oven/bun:1 AS base
WORKDIR /app
COPY . .

FROM base AS builder
RUN bun install --frozen-lockfile

RUN apt-get update && apt-get install -y --no-install-recommends nodejs && rm -rf /var/lib/apt/lists/*

# Vite substitutes these into index.html and inlines them into the bundle, so
# they are build inputs rather than container environment. They are fixed here
# rather than taken as build arguments: the image is built once and deployed
# as-is, and a value the build does not receive is a build that should not
# succeed. Change the name here and in .env together.
ENV VITE_APP_NAME="RqArk Cloud" \
    VITE_APP_DESCRIPTION="Console for RQArk Cloud: chats, agents, tasks and workspaces." \
    VITE_API_BASE_URL=/api \
    VITE_AGENT_API_BASE_URL=/agent-api
RUN bun run build

FROM nginx:1.23.1-alpine

WORKDIR /www

COPY --from=builder /app/dist/ .

# The nginx entrypoint runs envsubst over every file under /etc/nginx/templates
# and writes the result to /etc/nginx/conf.d, so the two upstream addresses stay
# out of the image: a deployment that reaches the backends at other names sets
# DATA_CLOUD_URL and AGENT_CLOUD_URL and needs no rebuild.
#
# These defaults are the development ones: host.docker.internal only exists on
# Docker Desktop and only when the backends run on the host outside Docker.
ENV DATA_CLOUD_URL=http://host.docker.internal:7302 \
    AGENT_CLOUD_URL=http://host.docker.internal:8000

COPY ./nginx.conf.template /etc/nginx/templates/default.conf.template

EXPOSE 80
