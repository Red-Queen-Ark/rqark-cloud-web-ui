FROM oven/bun:1 AS base
WORKDIR /app
COPY . .

FROM base AS builder
RUN bun install --frozen-lockfile

RUN apt-get update && apt-get install -y --no-install-recommends nodejs && rm -rf /var/lib/apt/lists/*

# Vite substitutes these into index.html and inlines them into the bundle, so
# they are build inputs rather than container environment. They are fixed here
# rather than taken as build arguments: the image is built once and deployed
# as-is, and a value the build does not receive is a build that should not
# succeed. Change the name here and in .env together.
ENV VITE_APP_NAME="RqArk Cloud" \
    VITE_APP_DESCRIPTION="Console for RQArk Cloud: chats, agents, tasks and workspaces." \
    VITE_API_BASE_URL=/api \
    VITE_AGENT_API_BASE_URL=/agent-api
RUN bun run build

FROM nginx:1.23.1-alpine

WORKDIR /www

COPY --from=builder /app/dist/ .

COPY ./nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
